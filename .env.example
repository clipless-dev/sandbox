# Your test key: request early access at https://clipless.dev and you get a workspace
# with a test environment. Test sessions are free; email reaches only your own address.
CLIPLESS_API_KEY=cls_test_…

# Verifies the webhook calls: create it with `bunx clipless secrets signing-secret`.
CLIPLESS_SIGNING_SECRET=whsec_…

# A public address for this app's webhook, read when you deploy (see README).
CLIPLESS_WEBHOOK_URL=https://…trycloudflare.com/api/webhooks/clipless

# Only for a local Clipless; the default is https://api.clipless.dev.
# CLIPLESS_URL=http://localhost:3000
